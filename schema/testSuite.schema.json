{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/winccoa/testSuite.schema.json",
    "title": "WinCC OA Test Framework testSuite config",
    "type": "object",
    "additionalProperties": true,
    "$defs": {
        "langString": {
            "description": "Either a plain string (single language) or an object mapping locales to strings.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 0
                },
                {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            ]
        },
        "langStringNonEmpty": {
            "description": "langString, but requires non-empty string when represented as a string.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            ]
        },
        "step": {
            "description": "A project step name, or an object with start options.",
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                        "id": { "type": "string", "minLength": 1 },
                        "serialized": { "type": "boolean" },
                        "lockId": { "type": "string", "minLength": 1 },
                        "delayedStart": { "type": "number", "minimum": 0 }
                    }
                }
            ]
        },
        "remoteProject": {
            "description": "Test project executed on a (remote) node; omit NODE for the current node.",
            "type": "object",
            "required": ["PROJECT_CONFIG"],
            "properties": {
                "NODE": { "type": "string", "minLength": 1 },
                "PROJECT_CONFIG": { "type": "string", "minLength": 1 },
                "STEPS": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/step" }
                }
            }
        }
    },
    "required": ["NAME", "TEST_PROJECTS"],
    "properties": {
        "FILE_VERSION": {
            "type": "string",
            "minLength": 1
        },
        "NAME": {
            "$ref": "#/$defs/langStringNonEmpty"
        },
        "DESCRIPTION": {
            "$ref": "#/$defs/langString"
        },
        "TEST_PROJECTS": {
            "description": "Test projects run one after another. An inner array is a group of projects that run in parallel.",
            "type": "array",
            "items": {
                "oneOf": [
                    { "type": "string", "minLength": 1 },
                    {
                        "type": "array",
                        "items": {
                            "oneOf": [
                                { "type": "string", "minLength": 1 },
                                { "$ref": "#/$defs/remoteProject" }
                            ]
                        }
                    }
                ]
            }
        },
        "USER_DATA": {
            "type": "object",
            "additionalProperties": true
        }
    }
}
